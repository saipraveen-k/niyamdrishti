# NiyamDrishti Backend — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to source control.

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=NiyamDrishti
APP_ENV=development
# development | staging | production
DEBUG=true
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# =============================================================================
# SUPABASE
# =============================================================================
# Found in: Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# NEVER expose SUPABASE_SERVICE_ROLE_KEY to the browser

# =============================================================================
# DATABASE (Supabase PostgreSQL)
# =============================================================================
# Found in: Supabase Dashboard > Settings > Database > Connection string
DATABASE_URL=postgresql+asyncpg://postgres:your-password@db.your-project.supabase.co:5432/postgres
# For migrations (synchronous):
DATABASE_URL_SYNC=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# =============================================================================
# AI PROVIDERS
# =============================================================================
# Primary provider: openai | anthropic
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EXTRACTION_MODEL=gpt-4o

# Anthropic (alternative)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_EXTRACTION_MODEL=claude-3-5-sonnet-20241022

# =============================================================================
# DOCUMENT PROCESSING
# =============================================================================
# Maximum file size in bytes (default: 20MB)
MAX_UPLOAD_SIZE_BYTES=20971520
# Maximum PDF pages
MAX_PDF_PAGES=200
# Tesseract binary path (leave empty for system default)
TESSERACT_CMD=
# Minimum OCR confidence threshold (0-100)
OCR_MIN_CONFIDENCE=60

# =============================================================================
# STORAGE (Supabase Storage)
# =============================================================================
OFFICIAL_DOCS_BUCKET=official-documents
STUDENT_UPLOADS_BUCKET=student-uploads
REPORTS_BUCKET=generated-reports
# Signed URL expiry in seconds (default: 1 hour)
SIGNED_URL_EXPIRY=3600

# =============================================================================
# DOCUMENT RETENTION
# =============================================================================
# Student document retention in days
STUDENT_DOC_RETENTION_DAYS=30

# =============================================================================
# AUTHENTICATION
# =============================================================================
# JWT expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# Rate limiting: max login attempts per window
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15

# =============================================================================
# EMAIL (for notifications — optional)
# =============================================================================
# smtp | sendgrid | supabase_smtp
EMAIL_PROVIDER=supabase_smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@niyamdrishti.in
FROM_NAME=NiyamDrishti

# =============================================================================
# SMS / PHONE OTP (required for Phone OTP feature)
# =============================================================================
# Configure in Supabase Dashboard > Authentication > Providers > Phone
# This feature requires a Twilio or MSG91 account
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=console

# =============================================================================
# CORS
# =============================================================================
# Comma-separated list of allowed origins (no trailing slash)
CORS_ORIGINS=http://localhost:3000

# =============================================================================
# WORKER
# =============================================================================
# Worker polling interval in seconds
WORKER_POLL_INTERVAL=5
WORKER_MAX_RETRIES=3
WORKER_RETRY_BACKOFF_SECONDS=60
